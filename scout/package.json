{
  "name": "amendoa-scout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Phone-native reply radar: polls an X List, scores tweets, pushes high-value alerts to your phone.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx src/main.ts",
    "register-rule": "tsx scripts/registerRule.ts",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.20.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1"
  }
}
