{
    "manifest_version": 3,
    "name": "Amendoa",
    "version": "1.0.0",
    "description": "The Glass HUD for X",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "*://twitter.com/*",
        "*://x.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://twitter.com/*",
                "*://x.com/*"
            ],
            "js": [
                "assets/content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "assets/*",
                "assets/injector.js"
            ],
            "matches": [
                "*://twitter.com/*",
                "*://x.com/*"
            ]
        }
    ]
}