{
    "manifest_version": 3,
    "name": "Amendoa",
    "version": "1.0.1",
    "description": "Reply targeting HUD for X - find high-value reply opportunities and grow your network",
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "*://twitter.com/*",
        "*://x.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://twitter.com/*",
                "*://x.com/*"
            ],
            "js": [
                "assets/content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "assets/*",
                "assets/injector.js"
            ],
            "matches": [
                "*://twitter.com/*",
                "*://x.com/*"
            ]
        }
    ]
}